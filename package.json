{
  "name": "hookit-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "server:build": "npm --prefix functions run build",
    "server:test": "npm run server:build && node --test functions/lib/security.test.js functions/lib/schema.test.js functions/lib/httpServer.test.js",
    "format": "prettier --write src server functions/src vite.config.ts vitest.config.ts",
    "format:check": "prettier --check src server functions/src vite.config.ts vitest.config.ts",
    "deploy:spark": "npm run build && firebase deploy --only \"firestore:rules,firestore:indexes,hosting\"",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "test:worker": "node --test worker/index.test.js"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.86.0"
  }
}
