# Copy to .env.YOUR_FIREBASE_PROJECT_ID; never put server secrets in VITE_ variables.
APP_ORIGIN=https://YOUR_PROJECT.web.app
API_BASE_URL=https://asia-northeast3-YOUR_PROJECT.cloudfunctions.net/api
META_APP_ID=
# Choose the version supported by your Meta application. Required, no silent default.
META_GRAPH_VERSION=
# Set these through Firebase Secret Manager, not this file:
# META_APP_SECRET
# META_WEBHOOK_VERIFY_TOKEN
# TOKEN_ENCRYPTION_KEY (32 random bytes, base64 encoded)
